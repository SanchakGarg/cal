# ---------------------------------------------------------------------------
# Copy to .env and adjust. Nothing here is secret by default; change
# JWT_SECRET (and the Postgres password) before exposing the app.
# ---------------------------------------------------------------------------

# --- database ---
# Local dev against docker compose postgres:
DATABASE_URL=postgres://cal:cal@localhost:5432/cal
# Inside docker compose (the `app` profile sets this for you):
# DATABASE_URL=postgres://cal:cal@postgres:5432/cal

# --- api / web ---
API_PORT=3001
# Public URL of the API. Used as the JWT issuer and for OIDC redirects.
API_ORIGIN=http://localhost:3001
# Public URL of the web app. Used for CORS, booking links and OIDC hand-back.
# When SERVE_WEB=true this is the same origin as the API.
WEB_ORIGIN=http://localhost:5173
# Serve the built web bundle from the API process (single-container hosting).
SERVE_WEB=false

# --- tokens we issue ourselves ---
# Use at least 32 random characters: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Zitadel OIDC login (instance hosted elsewhere) ---
# Set to false to hide the SSO button entirely; the /v2/auth/oidc/* routes then 403.
AUTH_OIDC_ENABLED=false
OIDC_ISSUER=https://your-instance.zitadel.cloud
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only, recommended for Zitadel "User Agent" apps).
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/v2/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/auth/login

# --- guest login (no provider needed, for local testing and demos) ---
AUTH_GUEST_ENABLED=true
GUEST_AUTO_CREATE=true
