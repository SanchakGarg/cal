# ---------------------------------------------------------------------------
# Copy to .env and adjust. Nothing here is secret by default; change
# JWT_SECRET (and the Postgres password) before exposing the app.
# ---------------------------------------------------------------------------

# --- database ---
# Local dev against docker compose postgres:
DATABASE_URL=postgres://cal:cal@localhost:5432/cal
# Inside docker compose (the `app` profile sets this for you):
# DATABASE_URL=postgres://cal:cal@postgres:5432/cal

# --- api / web ---
API_PORT=3001
# Public URL of the API. Used as the JWT issuer and for OIDC redirects.
API_ORIGIN=http://localhost:3001
# Public URL of the web app. Used for CORS, booking links and OIDC hand-back.
# When SERVE_WEB=true this is the same origin as the API.
WEB_ORIGIN=http://localhost:5173
# Serve the built web bundle from the API process (single-container hosting).
SERVE_WEB=false

# --- tokens we issue ourselves ---
# Use at least 32 random characters: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Zitadel OIDC login (instance hosted elsewhere) ---
# Set to false to hide the SSO button entirely; the /v2/auth/oidc/* routes then 403.
AUTH_OIDC_ENABLED=false
OIDC_ISSUER=https://your-instance.zitadel.cloud
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only, recommended for Zitadel "User Agent" apps).
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/v2/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/auth/login

# --- Google ---
# One OAuth client in Google Cloud Console backs both features below. Add
# ${API_ORIGIN}/v2/auth/google/callback as an Authorized redirect URI, and
# ${WEB_ORIGIN} as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v2/auth/google/callback

# "Continue with Google" on the login page. Needs the OAuth consent screen to
# request openid/email/profile only.
AUTH_GOOGLE_ENABLED=false

# Google Calendar linking, under Settings -> Calendars. Independent of the
# login button above: leave AUTH_GOOGLE_ENABLED=false and this on to let people
# sign in some other way and still connect a calendar. Enable the Google
# Calendar API on the project and add the calendar.events and calendar.readonly
# scopes to the consent screen.
GOOGLE_CALENDAR_ENABLED=false

# Ask Google for a Meet link on synced events that have no location of their
# own. Requires the calendar.events scope (already requested when linking).
GOOGLE_CREATE_MEET_LINKS=false

# --- guest login (no provider needed, for local testing and demos) ---
AUTH_GUEST_ENABLED=true
GUEST_AUTO_CREATE=true

# --- email (SMTP) ---
# Leave SMTP_HOST empty to run without mail: the app still works end to end and
# every message is logged instead of sent. Set it to switch mail on — welcome,
# team invitation, booking confirmation, reschedule and cancellation emails.
SMTP_HOST=
SMTP_PORT=587
# Port 465 speaks TLS immediately; 587 and 25 upgrade with STARTTLS. Defaults
# from SMTP_PORT, so you normally do not need to set this.
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The From header. Must be an address the SMTP account is allowed to send as.
MAIL_FROM=Cal <no-reply@localhost>

# --- uploads (avatars and team logos) ---
# Where uploaded images are written, relative to the repo root unless absolute.
# Put this on a volume that survives a redeploy or pictures vanish on restart.
UPLOAD_DIR=var/uploads
# The URL path they are served from. The API serves it; in dev, Vite proxies it.
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_BYTES=2097152

# --- local-only escape hatches (leave off anywhere real) ---
# Turning this on returns the booker email verification code in the API
# response, which defeats the check entirely.
EXPOSE_VERIFICATION_CODES=false
# Webhook subscriber URLs are fetched by the server, so private and loopback
# addresses are refused. Enable only when subscribers genuinely live on the
# same private network.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Applies to the local `npm run dev` processes only — the Docker app profile pins
# NODE_ENV=production in docker-compose.yml regardless of what is set here.
# `production` returns generic 5xx error bodies and requires an explicit
# JWT_SECRET rather than falling back to the well-known development value.
NODE_ENV=development
